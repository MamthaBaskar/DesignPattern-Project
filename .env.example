# AI Provider Configuration
# Supported options: openai, gemini, anthropic, custom
AI_PROVIDER=openai

# OpenAI / OpenAI-Compatible Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Request Timeout (seconds)
AI_REQUEST_TIMEOUT=15.0

# Optional Tesseract OCR Executable Path (if not in standard PATH)
# Example for Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

